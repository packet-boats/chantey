index 00000000..00a96a7b
--- /dev/null
+++ b/adapter/inbound/password_users.go
@@ -0,0 +1,55 @@
+package inbound
+
+import (
+	"strings"
+	"sync/atomic"
+
+	"github.com/sagernet/sing/common/auth"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// PasswordUsers holds the username and password users of an inbound (SOCKS,
+// HTTP, mixed, naive) so the SSM API can replace them at run time. The SSM
+// user name is the username clients authenticate with.
+type PasswordUsers struct {
+	authenticator atomic.Pointer[auth.Authenticator]
+}
+
+func NewPasswordUsers(users []auth.User) *PasswordUsers {
+	u := &PasswordUsers{}
+	u.authenticator.Store(auth.NewAuthenticator(users))
+	return u
+}
+
+// Load returns the current users. A nil result means authentication is off,
+// which only happens for a static config with no users.
+func (u *PasswordUsers) Load() *auth.Authenticator {
+	return u.authenticator.Load()
+}
+
+// SetManaged turns authentication on for an inbound bound to the SSM API, so
+// an empty user list rejects every client instead of allowing all of them.
+// The SSM API binds inbounds before they start listening.
+func (u *PasswordUsers) SetManaged() {
+	u.authenticator.CompareAndSwap(nil, &auth.Authenticator{})
+}
+
+func (u *PasswordUsers) Update(users []string, passwords []string) error {
+	userList := make([]auth.User, 0, len(users))
+	for i, user := range users {
+		password := passwords[i]
+		if user == "" || password == "" {
+			return E.New("empty username or password for user ", user)
+		}
+		if strings.Contains(user, ":") || len(user) > 255 || len(password) > 255 {
+			return E.New("invalid username or password for user ", user)
+		}
+		userList = append(userList, auth.User{Username: user, Password: password})
+	}
+	authenticator := auth.NewAuthenticator(userList)
+	if authenticator == nil {
+		authenticator = &auth.Authenticator{}
+	}
+	u.authenticator.Store(authenticator)
+	return nil
+}
