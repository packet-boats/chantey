+// UpdateUsers replaces the users at run time, for the SSM API; each credential
+// is "uuid:password". Sessions of removed users are closed.
+func (h *Inbound) UpdateUsers(users []string, credentials []string) error {
+	uuids := make([][16]byte, len(users))
+	passwords := make([]string, len(users))
+	for i, credential := range credentials {
+		id, password, _ := strings.Cut(credential, ":")
+		userUUID, err := uuid.FromString(id)
+		if err != nil {
+			return E.Cause(err, "invalid uuid for user ", users[i])
+		}
+		uuids[i] = userUUID
+		passwords[i] = password
+	}
+	h.server.UpdateUsers(users, uuids, passwords)
+	return nil
+}
