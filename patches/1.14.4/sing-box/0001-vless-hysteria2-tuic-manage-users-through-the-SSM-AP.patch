+func (h *Inbound) newService(users []string, uuids []string, flows []string) *vless.Service[string] {
+	service := vless.NewService[string](h.logger, adapter.NewUpstreamContextHandler(h.newConnectionEx, h.newPacketConnectionEx))
+	service.UpdateUsers(users, uuids, flows)
+	return service
+}
