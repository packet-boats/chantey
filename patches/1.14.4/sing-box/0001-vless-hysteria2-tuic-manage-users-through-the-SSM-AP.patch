+package inbound
+
+import (
+	"strings"
+
+	F "github.com/sagernet/sing/common/format"
+)
+
+const unnamedUserPrefix = "\x00"
+
+// UserKey returns the key a user is stored under in a protocol service: its
+// name, or for an unnamed user of a static config a key that cannot collide
+// with a name. Keying users by name instead of list index keeps in-flight
+// connections attributed to the right user when the list changes at run time.
+func UserKey(index int, name string) string {
+	if name != "" {
+		return name
+	}
+	return unnamedUserPrefix + F.ToString(index)
+}
+
+// UserName returns the display name for a key and whether it is a real user
+// name that belongs in the connection metadata.
+func UserName(key string) (string, bool) {
+	if strings.HasPrefix(key, unnamedUserPrefix) {
+		return key[len(unnamedUserPrefix):], false
+	}
+	return key, key != ""
+}
