+func (h *Inbound) SetTracker(tracker adapter.SSMTracker) {
+	h.tracker = tracker
+}
+
+// UpdateUsers replaces the users at run time, for the SSM API. Each credential
+// is "uuid" or "uuid:flow". New connections use the new list; established
+// connections keep the user they authenticated as.
+func (h *Inbound) UpdateUsers(users []string, credentials []string) error {
+	uuids := make([]string, len(users))
+	flows := make([]string, len(users))
+	for i, credential := range credentials {
+		id, flow, _ := strings.Cut(credential, ":")
+		if _, err := uuid.FromString(id); err != nil {
+			return E.Cause(err, "invalid uuid for user ", users[i])
+		}
+		if flow != "" && flow != vless.FlowVision {
+			return E.New("unsupported flow for user ", users[i], ": ", flow)
+		}
+		uuids[i] = id
+		flows[i] = flow
+	}
+	h.service.Store(h.newService(users, uuids, flows))
+	return nil
+}
