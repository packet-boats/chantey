From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "packet-boats[bot]"
 <346322443+packet-boats[bot]@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:35:14 +0000
Subject: [PATCH] ssmapi: refuse empty credentials and roll back rejected
 changes

The SSM API stored a user before the inbound accepted it, so one
refused credential made every later call on that inbound fail. It now
rolls the change back when the inbound refuses it, and refuses an empty
credential on every inbound.

Co-Authored-By: Claude <noreply@anthropic.com>
Signed-off-by: packet-boats[bot] <346322443+packet-boats[bot]@users.noreply.github.com>
---
 service/ssmapi/user.go | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/service/ssmapi/user.go b/service/ssmapi/user.go
index 26bc621a..e30e170c 100644
--- a/service/ssmapi/user.go
+++ b/service/ssmapi/user.go
@@ -59,8 +59,17 @@ func (m *UserManager) Add(username string, password string) error {
 	if _, found := m.usersMap[username]; found {
 		return E.New("user ", username, " already exists")
 	}
+	if password == "" {
+		return E.New("missing credential for user ", username)
+	}
 	m.usersMap[username] = password
-	return m.postUpdate(true)
+	err := m.postUpdate(true)
+	if err != nil {
+		// The inbound refused the new list and kept the old one; keep the
+		// manager in step, or every later change would carry the bad entry.
+		delete(m.usersMap, username)
+	}
+	return err
 }
 
 func (m *UserManager) Get(username string) (string, bool) {
@@ -75,8 +84,20 @@ func (m *UserManager) Get(username string) (string, bool) {
 func (m *UserManager) Update(username string, password string) error {
 	m.access.Lock()
 	defer m.access.Unlock()
+	if password == "" {
+		return E.New("missing credential for user ", username)
+	}
+	oldPassword, loaded := m.usersMap[username]
 	m.usersMap[username] = password
-	return m.postUpdate(true)
+	err := m.postUpdate(true)
+	if err != nil {
+		if loaded {
+			m.usersMap[username] = oldPassword
+		} else {
+			delete(m.usersMap, username)
+		}
+	}
+	return err
 }
 
 func (m *UserManager) Delete(username string) error {
