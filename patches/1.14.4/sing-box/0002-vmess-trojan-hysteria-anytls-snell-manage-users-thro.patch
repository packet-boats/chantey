+func (h *Inbound) SetTracker(tracker adapter.SSMTracker) {
+	h.tracker = tracker
+	// A managed inbound runs multi-user even before its first user is added,
+	// so the shared PSK alone never authenticates. The SSM API binds inbounds
+	// before they start.
+	h.service = h.multi
+	h.hasUsers = true
+}
+
+// UpdateUsers replaces the users at run time, for the SSM API; each credential
+// is the user's key. Every request is authenticated, including requests on
+// reused connections, so removed users can open nothing new.
+func (h *Inbound) UpdateUsers(users []string, userKeys []string) error {
+	keyList := make([][]byte, len(userKeys))
+	for index, key := range userKeys {
+		keyList[index] = []byte(key)
+	}
+	return h.multi.UpdateUsers(users, keyList)
+}
+
