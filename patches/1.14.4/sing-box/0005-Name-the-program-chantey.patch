 cmd/sing-box/cmd_version.go                | 2 +-
 experimental/clashapi/server.go            | 2 +-
 service/origin_ca/service.go               | 2 +-
 service/ssmapi/api.go                      | 2 +-
 10 files changed, 11 insertions(+), 11 deletions(-)

