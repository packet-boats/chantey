From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "packet-boats[bot]"
 <346322443+packet-boats[bot]@users.noreply.github.com>
Date: Fri, 23 Oct 2026 14:52:58 +0000
Subject: [PATCH] hysteria2, tuic: update users live and close revoked sessions

The services accept a new user list while they run. A removed user's
open sessions are closed when the list changes, and their new
connections are refused.

Co-Authored-By: Claude <noreply@anthropic.com>
Signed-off-by: packet-boats[bot] <346322443+packet-boats[bot]@users.noreply.github.com>
---
 hysteria2/service.go | 30 ++++++++++++++++++++++++
 tuic/service.go      | 55 ++++++++++++++++++++++++++++++++++++--------
 2 files changed, 75 insertions(+), 10 deletions(-)

diff --git a/hysteria2/service.go b/hysteria2/service.go
index cf453d2..55a07a3 100644
--- a/hysteria2/service.go
+++ b/hysteria2/service.go
@@ -76,6 +76,9 @@ type Service[U comparable] struct {
 	quicListener          io.Closer
 	bbrProfile            congestion_meta2.Profile
 	realmServer           *realm.Server
+	userAccess            sync.RWMutex
+	sessionAccess         sync.Mutex
+	sessions              map[*serverSession[U]]struct{}
 }
 
 func NewService[U comparable](options ServiceOptions) (*Service[U], error) {
@@ -145,15 +148,31 @@ func NewService[U comparable](options ServiceOptions) (*Service[U], error) {
 		masqueradeHandler:     options.MasqueradeHandler,
 		bbrProfile:            bbrProfile,
 		realmServer:           realmServer,
+		sessions:              make(map[*serverSession[U]]struct{}),
 	}, nil
 }
 
+// UpdateUsers replaces the user list. It may be called while the service is
+// running: sessions whose password no longer maps to the same user are closed.
 func (s *Service[U]) UpdateUsers(userList []U, passwordList []string) {
 	userMap := make(map[string]U)
 	for i, user := range userList {
 		userMap[passwordList[i]] = user
 	}
+	s.userAccess.Lock()
 	s.userMap = userMap
+	s.userAccess.Unlock()
+	s.sessionAccess.Lock()
+	var revoked []*serverSession[U]
+	for session := range s.sessions {
+		if user, loaded := userMap[session.authKey]; !loaded || user != session.authUser {
+			revoked = append(revoked, session)
+		}
+	}
+	s.sessionAccess.Unlock()
+	for _, session := range revoked {
+		_ = session.quicConn.CloseWithError(0, "")
+	}
 }
 
 func (s *Service[U]) Start(conn net.PacketConn) error {
@@ -253,6 +272,9 @@ func (s *Service[U]) handleConnection(connection *quic.Conn) {
 	}
 	_ = httpServer.ServeQUICConn(connection)
 	_ = connection.CloseWithError(0, "")
+	s.sessionAccess.Lock()
+	delete(s.sessions, session)
+	s.sessionAccess.Unlock()
 }
 
 type serverSession[U comparable] struct {
@@ -264,6 +286,7 @@ type serverSession[U comparable] struct {
 	connErr       error
 	authenticated bool
 	authUser      U
+	authKey       string
 	udpAccess     sync.RWMutex
 	udpConnMap    map[uint32]*udpPacketConn
