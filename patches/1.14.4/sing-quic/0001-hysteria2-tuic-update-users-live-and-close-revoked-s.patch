@@ -104,8 +109,22 @@ func (s *Service[U]) UpdateUsers(userList []U, uuidList [][16]byte, passwordList
 		userMap[uuidList[index]] = userList[index]
 		passwordMap[userList[index]] = passwordList[index]
 	}
+	s.userAccess.Lock()
 	s.userMap = userMap
 	s.passwordMap = passwordMap
+	s.userAccess.Unlock()
+	// Close sessions whose UUID and password no longer authenticate the same user.
+	s.sessionAccess.Lock()
+	var revoked []*serverSession[U]
+	for session := range s.sessions {
+		if user, loaded := userMap[session.authUUID]; !loaded || user != session.authUser || passwordMap[user] != session.authPassword {
+			revoked = append(revoked, session)
+		}
+	}
+	s.sessionAccess.Unlock()
+	for _, session := range revoked {
+		session.closeWithError(E.New("user removed"))
+	}
 }
 
 func (s *Service[U]) Start(conn net.PacketConn) error {
@@ -170,20 +189,28 @@ func (s *Service[U]) handleConnection(connection *quic.Conn) {
 		udpConnMap: make(map[uint16]*udpPacketConn),
 	}
 	session.handle()
+	go func() {
+		<-connection.Context().Done()
+		s.sessionAccess.Lock()
+		delete(s.sessions, session)
+		s.sessionAccess.Unlock()
+	}()
 }
 
