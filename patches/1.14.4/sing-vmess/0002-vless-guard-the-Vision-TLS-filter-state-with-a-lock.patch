From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "packet-boats[bot]"
 <346322443+packet-boats[bot]@users.noreply.github.com>
Date: Sat, 24 Oct 2026 10:28:57 +0000
Subject: [PATCH] vless: guard the Vision TLS filter state with a lock

Read and Write both run the TLS filter and read what it found
(isTLS, isTLS12orAbove, enableXTLS and the number of packets still to
filter), from different goroutines and without a common lock, which
the race detector reports while a Vision connection carries traffic in
both directions. The filter state now has its own lock: filterTLS takes
it, and Read and Write read the state through it. Write takes one
snapshot per call, so its padding decisions see a consistent state.

Co-Authored-By: Claude <noreply@anthropic.com>
Signed-off-by: packet-boats[bot] <346322443+packet-boats[bot]@users.noreply.github.com>
---
 vless/vision.go | 59 +++++++++++++++++++++++++++++++------------------
 1 file changed, 37 insertions(+), 22 deletions(-)

diff --git a/vless/vision.go b/vless/vision.go
index 87cd030..b06e3b2 100644
--- a/vless/vision.go
+++ b/vless/vision.go
@@ -40,10 +40,13 @@ type VisionConn struct {
 	reader      *bufio.ChunkReader
 	writer      N.VectorisedWriter
 	writeAccess sync.Mutex
-	input       *bytes.Reader
-	rawInput    *bytes.Buffer
-	netConn     net.Conn
-	logger      logger.Logger
+	// filterAccess guards the TLS filter state, isTLS through enableXTLS
+	// below, which both Read and Write update.
+	filterAccess sync.Mutex
+	input        *bytes.Reader
+	rawInput     *bytes.Buffer
+	netConn      net.Conn
+	logger       logger.Logger
 
 	userUUID               [16]byte
 	isTLS                  bool
@@ -138,7 +141,7 @@ func (c *VisionConn) Read(p []byte) (n int, err error) {
 			}
 			bufferBytes = chunkBuffer.Bytes()
 		}
-		if c.withinPaddingBuffers || c.numberOfPacketToFilter > 0 {
+		if c.withinPaddingBuffers || c.filtering() {
 			buffers := c.unPadding(bufferBytes)
 			if chunkBuffer != nil {
 				chunkBuffer.Reset()
@@ -176,15 +179,11 @@ func (c *VisionConn) Read(p []byte) (n int, err error) {
 			} else {
 				c.withinPaddingBuffers = false
 			}
-			if c.numberOfPacketToFilter > 0 {
-				c.filterTLS(buf.ToSliceMulti(buffers))
-			}
+			c.filterTLS(buf.ToSliceMulti(buffers))
 			c.remainingBuffers = buffers
 			continue
 		} else {
-			if c.numberOfPacketToFilter > 0 {
-				c.filterTLS([][]byte{bufferBytes})
-			}
+			c.filterTLS([][]byte{bufferBytes})
 			if chunkBuffer != nil {
 				c.remainingBuffers = append(c.remainingBuffers, buf.As(chunkBuffer.Bytes()))
 				chunkBuffer.Reset() // chunkBuffer should not be release and only reused after c.remainingBuffers be emptied, so must reset at here
@@ -198,30 +197,29 @@ func (c *VisionConn) Read(p []byte) (n int, err error) {
 func (c *VisionConn) Write(p []byte) (n int, err error) {
 	c.writeAccess.Lock()
 	defer c.writeAccess.Unlock()
-	if c.numberOfPacketToFilter > 0 {
-		c.filterTLS([][]byte{p})
-	}
+	c.filterTLS([][]byte{p})
 	if c.isPadding {
+		isTLS, isTLS12orAbove, enableXTLS, toFilter := c.tlsState()
 		inputLen := len(p)
 		buffers := reshapeBuffer(p)
 		var specIndex int
 		for i, buffer := range buffers {
-			if c.isTLS && buffer.Len() > 6 && bytes.Equal(tlsApplicationDataStart, buffer.To(3)) {
+			if isTLS && buffer.Len() > 6 && bytes.Equal(tlsApplicationDataStart, buffer.To(3)) {
 				var command byte = commandPaddingEnd
-				if c.enableXTLS {
+				if enableXTLS {
 					c.directWrite.Store(true)
 					specIndex = i
 					command = commandPaddingDirect
 				}
 				c.isPadding = false
-				buffers[i] = c.padding(buffer, command)
+				buffers[i] = c.padding(buffer, command, isTLS)
 				break
-			} else if !c.isTLS12orAbove && c.numberOfPacketToFilter <= 1 {
+			} else if !isTLS12orAbove && toFilter <= 1 {
 				c.isPadding = false
-				buffers[i] = c.padding(buffer, commandPaddingEnd)
+				buffers[i] = c.padding(buffer, commandPaddingEnd, isTLS)
 				break
 			}
-			buffers[i] = c.padding(buffer, commandPaddingContinue)
+			buffers[i] = c.padding(buffer, commandPaddingContinue, isTLS)
 		}
 		if c.directWrite.Load() {
 			encryptedBuffer := buffers[:specIndex+1]
@@ -251,7 +249,24 @@ func (c *VisionConn) Write(p []byte) (n int, err error) {
 	}
 }
 
+func (c *VisionConn) filtering() bool {
+	c.filterAccess.Lock()
+	defer c.filterAccess.Unlock()
+	return c.numberOfPacketToFilter > 0
+}
+
+func (c *VisionConn) tlsState() (isTLS bool, isTLS12orAbove bool, enableXTLS bool, numberOfPacketToFilter int) {
+	c.filterAccess.Lock()
+	defer c.filterAccess.Unlock()
+	return c.isTLS, c.isTLS12orAbove, c.enableXTLS, c.numberOfPacketToFilter
+}
+
 func (c *VisionConn) filterTLS(buffers [][]byte) {
+	c.filterAccess.Lock()
+	defer c.filterAccess.Unlock()
+	if c.numberOfPacketToFilter <= 0 {
+		return
+	}
 	for _, buffer := range buffers {
 		c.numberOfPacketToFilter--
 		if len(buffer) > 6 {
@@ -301,13 +316,13 @@ func (c *VisionConn) filterTLS(buffers [][]byte) {
 	}
 }
 
-func (c *VisionConn) padding(buffer *buf.Buffer, command byte) *buf.Buffer {
+func (c *VisionConn) padding(buffer *buf.Buffer, command byte, isTLS bool) *buf.Buffer {
 	contentLen := 0
 	paddingLen := 0
 	if buffer != nil {
 		contentLen = buffer.Len()
 	}
-	if contentLen < 900 && c.isTLS {
+	if contentLen < 900 && isTLS {
 		l, _ := rand.Int(rand.Reader, big.NewInt(500))
 		paddingLen = int(l.Int64()) + 900 - contentLen
 	} else {
