+// findUser matches an auth ID against the current users. It holds the user
+// lock only for the lookup, so UpdateUsers never waits on a client.
+func (s *Service[U]) findUser(authId []byte) (user U, cmdKey [16]byte, legacyProtocol bool, legacyTimestamp uint64, err error) {
+	s.userAccess.RLock()
+	defer s.userAccess.RUnlock()
+	var decodedId [16]byte
+	for currUser, userIdBlock := range s.userIdCipher {
+		userIdBlock.Decrypt(decodedId[:], authId)
+		timestamp := int64(binary.BigEndian.Uint64(decodedId[:]))
+		checksum := binary.BigEndian.Uint32(decodedId[12:])
+		if crc32.ChecksumIEEE(decodedId[:12]) != checksum {
+			continue
+		}
+		if math.Abs(math.Abs(float64(timestamp))-float64(time.Now().Unix())) > 120 {
+			err = ErrBadTimestamp
+			return
+		}
+		if !s.replayFilter.Check(decodedId[:]) {
+			err = ErrReplay
+			return
+		}
+		return currUser, s.userKey[currUser], false, 0, nil
+	}
+	copy(decodedId[:], authId)
+	if currUser, loaded := s.alterIdMap[decodedId]; loaded {
+		return currUser.User, s.userKey[currUser.User], true, uint64(currUser.Time), nil
+	}
+	err = ErrBadRequest
+	return
+}
